FROM public.ecr.aws/docker/library/node:16-alpine3.15 as js-builder

ENV NODE_OPTIONS=--max_old_space_size=8000

WORKDIR /grafana

COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn .yarn
COPY packages packages
COPY plugins-bundled plugins-bundled

RUN yarn install

COPY tsconfig.json .eslintrc .editorconfig .browserslistrc .prettierrc.js babel.config.json .linguirc ./
COPY public public
COPY tools tools
COPY scripts scripts
COPY emails emails

ENV NODE_ENV production
RUN yarn build

FROM public.ecr.aws/docker/library/golang:1.19.3-alpine3.15 as go-builder

RUN apk add --no-cache gcc g++ make

WORKDIR /grafana

COPY go.mod go.sum embed.go Makefile build.go package.json ./
COPY packages/grafana-schema packages/grafana-schema
COPY public/app/plugins public/app/plugins
COPY public/api-spec.json public/api-spec.json
COPY pkg pkg
COPY scripts scripts
COPY cue.mod cue.mod
COPY .bingo .bingo
COPY kinds kinds

RUN go mod verify
RUN make build-go

# Final stage
FROM public.ecr.aws/docker/library/node:alpine3.15

LABEL maintainer="Grafana team <hello@grafana.com>"

ARG GF_UID="472"
ARG GF_GID="0"
ARG CONFIG_FILE="production.ini"

ENV PATH="/usr/share/grafana/bin:$PATH" \
  GF_PATHS_CONFIG="/etc/grafana/grafana.ini" \
  GF_PATHS_DATA="/var/lib/grafana" \
  GF_PATHS_HOME="/usr/share/grafana" \
  GF_PATHS_LOGS="/var/log/grafana" \
  GF_PATHS_PLUGINS="/var/lib/grafana/plugins" \
  GF_PATHS_PROVISIONING="/etc/grafana/provisioning"

WORKDIR $GF_PATHS_HOME

RUN apk add --no-cache ca-certificates bash tzdata musl-utils
RUN apk info -vv | sort

# Distrust the roots behind the compromised eMudhra intermediates (CVE-2026-111943,
# https://bugzilla.mozilla.org/show_bug.cgi?id=2083449). Each intermediate chains to
# emSign ECC Root CA - G3 and is also cross-signed under Comodo AAA Services, so both
# have to go. The other three emSign roots aren't in those chains but go too, so nothing
# from eMudhra is left. Go also reads every file in /etc/ssl/certs, so this goes through
# update-ca-certificates instead of editing the bundle. This can be removed once the base
# image ships ca-certificates 20261020 or later (Alpine 3.20+), which drops both roots.
# The checks match ca-cert-* names and file contents, not "aaa", because c_rehash's hash
# links can contain it (Security_Communication_ECC_RootCA1 is 5860aaa6.0).
RUN set -e; \
  roots="emSign_ECC_Root_CA_-_G3 emSign_ECC_Root_CA_-_C3 emSign_Root_CA_-_C1 emSign_Root_CA_-_G1 Comodo_AAA_Services_root"; \
  for c in $roots; do \
    sed -i "s|^mozilla/$c\.crt\$|!&|" /etc/ca-certificates.conf; \
    grep -qxF "!mozilla/$c.crt" /etc/ca-certificates.conf || { echo "$c not found in /etc/ca-certificates.conf"; exit 1; }; \
  done; \
  update-ca-certificates; \
  if ls /etc/ssl/certs | grep -E '^ca-cert-(emSign_|Comodo_AAA_)'; then echo "distrusted roots still linked in /etc/ssl/certs"; exit 1; fi; \
  for f in /etc/ssl/certs/*; do \
    for c in $roots; do \
      if cmp -s "$f" "/usr/share/ca-certificates/mozilla/$c.crt"; then echo "$f is still $c"; exit 1; fi; \
    done; \
  done

COPY conf ./conf

RUN if [ ! $(getent group "$GF_GID") ]; then \
  addgroup -S -g $GF_GID grafana; \
  fi

RUN export GF_GID_NAME=$(getent group $GF_GID | cut -d':' -f1) && \
  mkdir -p "$GF_PATHS_HOME/.aws" && \
  adduser -S -u $GF_UID -G "$GF_GID_NAME" grafana && \
  mkdir -p "$GF_PATHS_PROVISIONING/datasources" \
  "$GF_PATHS_PROVISIONING/dashboards" \
  "$GF_PATHS_PROVISIONING/notifiers" \
  "$GF_PATHS_PROVISIONING/plugins" \
  "$GF_PATHS_PROVISIONING/access-control" \
  "$GF_PATHS_PROVISIONING/alerting" \
  "$GF_PATHS_LOGS" \
  "$GF_PATHS_PLUGINS" \
  "$GF_PATHS_DATA" && \
  cp "$GF_PATHS_HOME/conf/$CONFIG_FILE" "$GF_PATHS_CONFIG" && \
  cp "$GF_PATHS_HOME/conf/ldap.toml" /etc/grafana/ldap.toml && \
  chown -R "grafana:$GF_GID_NAME" "$GF_PATHS_DATA" "$GF_PATHS_HOME/.aws" "$GF_PATHS_LOGS" "$GF_PATHS_PLUGINS" "$GF_PATHS_PROVISIONING" && \
  chmod -R 777 "$GF_PATHS_DATA" "$GF_PATHS_HOME/.aws" "$GF_PATHS_LOGS" "$GF_PATHS_PLUGINS" "$GF_PATHS_PROVISIONING"

COPY --from=go-builder /grafana/bin/*/grafana-server /grafana/bin/*/grafana-cli /grafana/bin/*/grafana ./bin/
COPY --from=js-builder /grafana/public ./public
COPY --from=js-builder /grafana/tools ./tools

# Copy plugin dependencies.
RUN pwd && ls -las

COPY ./scripts/build-soracom/plugins/. ${GF_PATHS_PLUGINS}/

EXPOSE 3000 9094/tcp
EXPOSE 9094/udp

COPY ./packaging/docker/run.sh /run.sh

USER grafana
ENTRYPOINT [ "/run.sh" ]
